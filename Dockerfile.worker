# Multi-stage build for Celery Worker
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies for compiling Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    make \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .

# Upgrade pip first
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install all Python packages
RUN pip install --no-cache-dir --user -r requirements.txt

# Production stage
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies only (smaller image)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 celeryuser

# Copy Python dependencies from builder to celeryuser's directory
COPY --from=builder /root/.local /home/celeryuser/.local

# Set proper ownership
RUN chown -R celeryuser:celeryuser /home/celeryuser/.local

# Copy application code
COPY ./app /app/app
RUN chown -R celeryuser:celeryuser /app

# Switch to non-root user
USER celeryuser

# Make sure scripts in .local are usable
ENV PATH=/home/celeryuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD celery -A app.core.celery inspect ping -d celery@$HOSTNAME || exit 1

# Default command - Start Celery worker for chat_incoming queue
CMD ["celery", "-A", "app.workers.celery_app", "worker", \
     "--loglevel=info", \
     "--queues=chat_incoming", \
     "--concurrency=4", \
     "--max-tasks-per-child=1000", \
     "--time-limit=1800", \
     "--soft-time-limit=1500", \
     "-n", "worker@%h"]
